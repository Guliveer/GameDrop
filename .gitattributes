# GameDrop — Git attributes
#
# Goals:
#   1. Identical bytes in the working tree on every OS (LF everywhere, except
#      scripts that Windows requires to be CRLF).
#   2. Binary files are never text-normalized or diffed as text.
#   3. Generated files do not pollute reviews, diffs, or language statistics.
#   4. Merge conflicts on generated dependency files resolve deterministically.
#
# See https://git-scm.com/docs/gitattributes for the full syntax.

# ---------------------------------------------------------------------------
# Default normalization
# ---------------------------------------------------------------------------
# Store text as LF in the repository and check it out as LF regardless of the
# developer's core.autocrlf setting. Source code, docs, and config are all
# line-ending sensitive in review diffs, so one canonical form avoids churn.
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Go source and module files
# ---------------------------------------------------------------------------
*.go     text eol=lf diff=golang
go.mod   text eol=lf
go.sum   text eol=lf merge=union -diff linguist-generated

# ---------------------------------------------------------------------------
# Configuration, data, and documentation formats
# ---------------------------------------------------------------------------
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.mod     text eol=lf
Dockerfile        text eol=lf
.dockerignore     text eol=lf
.gitignore        text eol=lf
.gitattributes    text eol=lf
.env.example      text eol=lf

# Windows-only scripts must keep CRLF or they break in cmd.exe/PowerShell hosts.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# ---------------------------------------------------------------------------
# Binary assets: never normalize, diff, or count as text
# ---------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary

# SQLite databases are runtime state, never content to merge.
*.db      binary
*.db-wal  binary
*.db-shm  binary
*.sqlite  binary
*.sqlite3 binary

# ---------------------------------------------------------------------------
# Generated and agent-local files
# ---------------------------------------------------------------------------
# Dependency metadata is generated by `go mod tidy`; do not review it as code.
go.sum linguist-generated -diff

# Documentation is prose: keep it out of language statistics and code review
# word counts, but still diffable.
docs/** linguist-documentation
README.md linguist-documentation
AGENTS.md linguist-documentation
CLAUDE.md linguist-documentation
GEMINI.md linguist-documentation
CONVENTIONS.md linguist-documentation

# Build output that may appear locally (ignored by Git anyway, but explicit).
gamedrop        binary
gamedrop.exe    binary

# ---------------------------------------------------------------------------
# Archives: exclude local agent/tooling state and CI metadata
# ---------------------------------------------------------------------------
.freebuff export-ignore
.github   export-ignore
.idea     export-ignore
.vscode   export-ignore
*.db      export-ignore
*.db-wal  export-ignore
*.db-shm  export-ignore

# ---------------------------------------------------------------------------
# Diffs
# ---------------------------------------------------------------------------
# Structured diffs for Go code (shows declarations rather than raw lines).
*.go diff=golang

# Never attempt a textual diff for opaque artifacts.
*.db     -diff
*.db-wal -diff
*.db-shm -diff
