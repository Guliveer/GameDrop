# GameDrop — environment variables
#
# Copy this file to .env and edit the values:
#
#   cp .env.example .env
#
# GameDrop loads .env automatically at startup (internal/envfile). Variables that
# really exist in the environment always win over entries from the file, and a
# missing .env is not an error. Set ENV_FILE_PATH to use a different file.
#
# Setup and one cycle, with the file loaded automatically:
#   Linux/macOS:  ./scripts/setup.sh  then  ./scripts/run.sh
#   Windows:      scripts\setup.bat   then  scripts\run.bat
#
# Docker: `docker run --env-file .env ...`
# Fly.io: `fly secrets set NAME=value` for secrets, or the [env] block in
# fly.toml for non-secret settings.
#
# Never commit a real .env file or real credentials.

# ---------------------------------------------------------------------------
# Application behavior
# ---------------------------------------------------------------------------

# development | production
#   development: human-readable logs, database defaults to ./gamedrop.db
#   production:  JSON logs (for Fly), database defaults to /data/offers.db
APP_MODE=development

# debug | info | warn | error
LOG_LEVEL=info

# Environment file loaded at startup. Defaults to .env in the working
# directory; a file named explicitly here must exist.
# ENV_FILE_PATH=.env

# SQLite database file. Parent directories are created automatically.
# Default: gamedrop.db (development) or /data/offers.db (production).
DATABASE_PATH=./gamedrop.db

# Per-request HTTP timeout. Accepts Go duration syntax (30s, 1500ms) or a bare
# number of seconds.
HTTP_TIMEOUT_SEC=30s

# Retries after the first attempt for idempotent requests (GET). Non-idempotent
# requests are never retried automatically.
HTTP_MAX_RETRIES=2

# User-Agent sent to storefronts and Telegram.
HTTP_USER_AGENT=GameDrop/1.0 (+https://github.com/Guliveer/GameDrop)

# Timeout for one store/country fetch, including its verification requests.
SOURCE_TIMEOUT_SEC=45s

# How many store/country fetches may run at once.
MAX_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Storefront region (independent from the Fly.io region)
# ---------------------------------------------------------------------------

# Comma separated ISO 3166-1 alpha-2 country codes. Each enabled store is
# queried once per country, and offers keep their country in their identity.
# Start with PL; add US only if you want US-region offers tracked as well.
STORE_COUNTRIES=PL

# Locale passed to stores that accept one. Steam receives a mapped language
# name, Epic receives the locale, GOG receives it as catalog locale.
STORE_LOCALE=pl-PL

# ---------------------------------------------------------------------------
# Stores
# ---------------------------------------------------------------------------

ENABLE_STEAM=true
ENABLE_EPIC=true
ENABLE_GOG=true

# Optional, best-effort. Prime Gaming loot needs an authenticated Amazon
# session; v1 ships a documented disabled adapter, so enabling this records a
# non-fatal source failure on every run.
ENABLE_PRIME=false

# ---------------------------------------------------------------------------
# Telegram notifications
# ---------------------------------------------------------------------------

# Leave empty to run without notifications (notification intents are then not
# created at all). When both token and chat ID are set, notifications turn on
# automatically.
# ENABLE_TELEGRAM=true forces the channel on (and fails validation without
# credentials); ENABLE_TELEGRAM=false forces it off even with credentials.
# ENABLE_TELEGRAM=

# Create a bot with @BotFather and read the token from there.
# Send /start to your bot, then read the chat ID from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delivery attempts per notification, including the first one. Failed attempts
# are retried on later runs with bounded backoff.
NOTIFY_MAX_ATTEMPTS=3
